    "build:mac:dmg": "tauri build --bundles dmg",
    "build:linux:deb": "tauri build --bundles deb"
  },
  "dependencies": {
    "@file-viewer/core": "2.1.19",
    "@file-viewer/preset-all": "2.1.19",
    "@file-viewer/renderer-spreadsheet": "2.1.19",
    "@file-viewer/vue3": "2.1.19",
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-dialog": "2.6.0",
    "@tauri-apps/plugin-opener": "2.5.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "pdfjs-dist": "6.0.227",
    "pinia": "^3.0.4",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@file-viewer/vite-plugin": "2.1.19",
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^5.2.1",
    "rimraf": "^6.1.3",
