{
  "name": "droidpilot",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "clean": "rimraf dist src-tauri/target",
    "tauri": "tauri",
    "build:win:exe": "tauri build --bundles nsis",
